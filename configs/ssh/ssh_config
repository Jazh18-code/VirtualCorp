# Per entrar als routers sense escriure tot el comando:
#   ssh -F configs/ssh/ssh_config mikrotik1
#
# Des del meu PC nomes arribo al mikrotik0 (port 2200 de VirtualBox),
# als altres hi entro saltant pel mikrotik0 (ProxyJump)

Host mikrotik0
    HostName 127.0.0.1
    Port 2200

Host mikrotik1
    HostName 10.2.0.226
    ProxyJump mikrotik0

Host mikrotik2
    HostName 10.2.0.230
    ProxyJump mikrotik0

Host mikrotik3
    HostName 10.2.0.234
    ProxyJump mikrotik0

# per a tots
Host mikrotik*
    User sysadmin
    IdentityFile ~/.ssh/vcorp_sysadmin
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
